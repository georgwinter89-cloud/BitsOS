/* The symbols the vDSO exports, all with version LINUX_2.6 as glibc and musl look them up
   (Linux's list, linux-7.3.1/arch/x86/entry/vdso/vdso64/vdso64.lds.S:17, without SGX, with the robust-futex
   helpers of CONFIG_FUTEX_ROBUST_UNLOCK and CONFIG_COMPAT as CachyOS builds it). */
LINUX_2.6 {
global:
	clock_gettime;
	__vdso_clock_gettime;
	gettimeofday;
	__vdso_gettimeofday;
	getcpu;
	__vdso_getcpu;
	time;
	__vdso_time;
	clock_getres;
	__vdso_clock_getres;
	getrandom;
	__vdso_getrandom;
	__vdso_futex_robust_list64_try_unlock;
	__vdso_futex_robust_list32_try_unlock;
local: *;
};
