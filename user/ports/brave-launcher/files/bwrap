#!/bin/sh
# BR-7: Brave's tree's `bwrap` stand-in (last on Brave's PATH, from the launcher). It sandboxes nothing: it answers
# as Bubblewrap does on a kernel without unprivileged user namespaces. glycin (gdk-pixbuf 2.44's image loaders)
# asks bwrap first and, on exactly this answer, runs its loader programs without a sandbox; when bwrap cannot be
# started at all, glycin fails every image instead, and GTK aborts on its first icon (Georg 24.10.: Brave died at a
# download). Since SX-3b every V2 image has the real Bubblewrap at /bin/bwrap, which comes first on PATH and wins
# (br/40-download.sh: "sandbox by /bin/bwrap"), so on V2 this file is never run; br/40-download.sh's host step still
# uses it to keep the host's bwrap away from the loaders. Retiring it is a BR item with a restage of the shared
# Brave stage (plan/notes/desk-C1.md).
echo "bwrap: No permissions to create a new namespace, likely because the kernel does not allow non-privileged user namespaces." >&2
exit 1
