+# BitsOS port switches. Read by both toolchains: the Cobalt side (libcobalt)
+# and the Starboard side (loader_app, the Linux test platform).
+declare_args() {
+  # Software compositing into a plain pixel buffer handed to the platform
+  # through the "dev.bitsos.Canvas" extension, instead of EGL/GLES.
+  cobalt_bitsos_canvas = false
+}
