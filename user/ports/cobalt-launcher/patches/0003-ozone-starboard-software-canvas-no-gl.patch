+// limitations under the License.
+
+#include "ui/ozone/platform/starboard/bitsos_canvas_starboard.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include "base/logging.h"
+#include "starboard/extension/bitsos_canvas.h"
+#include "starboard/system.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/core/SkSurface.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/vsync_provider.h"
+
+namespace ui {
+namespace {
+
+class BitsosCanvas : public SurfaceOzoneCanvas {
+ public:
+  BitsosCanvas(gfx::AcceleratedWidget widget,
+               const StarboardExtensionBitsosCanvasApi* api)
+      : widget_(widget), api_(api) {}
+  BitsosCanvas(const BitsosCanvas&) = delete;
+  BitsosCanvas& operator=(const BitsosCanvas&) = delete;
+  ~BitsosCanvas() override = default;
+
+  SkCanvas* GetCanvas() override {
+    return surface_ ? surface_->getCanvas() : nullptr;
+  }
+
+  void ResizeCanvas(const gfx::Size& size, float scale) override {
+    if (surface_ && surface_->width() == size.width() &&
+        surface_->height() == size.height()) {
+      return;
+    }
+    surface_ = SkSurfaces::Raster(
+        SkImageInfo::MakeN32Premul(size.width(), size.height()));
+  }
+
+  void PresentCanvas(const gfx::Rect& damage) override {
+    SkPixmap pm;
+    if (!surface_ || !surface_->peekPixels(&pm)) {
+      return;
+    }
+    gfx::Rect r =
+        gfx::IntersectRects(damage, gfx::Rect(pm.width(), pm.height()));
+    if (r.IsEmpty()) {
+      return;
+    }
+    api_->Present(reinterpret_cast<void*>(static_cast<intptr_t>(widget_)),
+                  pm.addr(), static_cast<int32_t>(pm.rowBytes()), pm.width(),
+                  pm.height(), r.x(), r.y(), r.width(), r.height());
+  }
+
+  // No vsync source: viz paces frames with its own begin-frame timer.
+  std::unique_ptr<gfx::VSyncProvider> CreateVSyncProvider() override {
+    return nullptr;
+  }
+
+ private:
+  const gfx::AcceleratedWidget widget_;
+  const StarboardExtensionBitsosCanvasApi* const api_;
+  sk_sp<SkSurface> surface_;
+};
+
+}  // namespace
+
+std::unique_ptr<SurfaceOzoneCanvas> CreateBitsosCanvas(
+    gfx::AcceleratedWidget widget) {
+  const auto* api = static_cast<const StarboardExtensionBitsosCanvasApi*>(
+      SbSystemGetExtension(kStarboardExtensionBitsosCanvasName));
+  if (!api || strcmp(api->name, kStarboardExtensionBitsosCanvasName) != 0 ||
+      api->version < 1 || !api->Present) {
+    LOG(ERROR) << "Starboard extension " << kStarboardExtensionBitsosCanvasName
+               << " is missing; software compositing cannot present.";
+    return nullptr;
+  }
+  LOG(INFO) << "Software compositing presents through "
+            << kStarboardExtensionBitsosCanvasName << " v" << api->version;
+  return std::make_unique<BitsosCanvas>(widget, api);
+}
+
+}  // namespace ui
