+#if BUILDFLAG(USE_STARBOARD_MEDIA)
+void SoftwareRenderer::DrawStarboardVideoHole(const VideoHoleDrawQuad* quad,
+                                              const SkMatrix& device_matrix) {
+  if (current_frame()->current_render_pass ==
+      current_frame()->root_render_pass) {
+    // Device space of the root pass is the window.
+    SkRect display_rect =
+        device_matrix.mapRect(gfx::RectToSkRect(quad->rect));
+    auto& setter = GetVideoGeometrySetter();
+    if (setter.is_bound()) {
+      setter->SetVideoGeometry(gfx::SkRectToRectF(display_rect),
+                               gfx::OVERLAY_TRANSFORM_NONE,
+                               quad->overlay_plane_id);
+    }
+  }
+  SkPaint paint;
+  paint.setBlendMode(SkBlendMode::kClear);
+  current_canvas_->drawRect(gfx::RectToSkRect(quad->visible_rect), paint);
+}
+#endif  // BUILDFLAG(USE_STARBOARD_MEDIA)
