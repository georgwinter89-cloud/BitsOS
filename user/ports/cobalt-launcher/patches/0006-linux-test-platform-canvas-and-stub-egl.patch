+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+#include "starboard/shared/x11/bitsos_canvas_x11.h"
+
+#include <stdint.h>
+
+#include <mutex>
+
+#include "starboard/common/log.h"
+#include "starboard/extension/bitsos_canvas.h"
+
+// Xlib last: its macros (None, Status, Bool) clash with other headers.
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+
+namespace starboard {
+namespace {
+
+// Own connection, used only from Chromium's compositor thread (under the
+// lock), so the application's display needs no XInitThreads().
+std::mutex g_mutex;
+Display* g_display = nullptr;
+Window g_window = 0;
+Visual* g_visual = nullptr;
+int g_depth = 0;
+GC g_gc = nullptr;
+
+bool BindWindow(Window window) {
+  if (!g_display) {
+    g_display = XOpenDisplay(nullptr);
+    if (!g_display) {
+      SB_LOG(ERROR) << "dev.bitsos.Canvas: XOpenDisplay failed";
+      return false;
+    }
+  }
+  if (window == g_window && g_gc) {
+    return true;
+  }
+  if (g_gc) {
+    XFreeGC(g_display, g_gc);
+    g_gc = nullptr;
+  }
+  XWindowAttributes attrs;
+  if (!XGetWindowAttributes(g_display, window, &attrs)) {
+    return false;
+  }
+  g_visual = attrs.visual;
+  g_depth = attrs.depth;
+  g_gc = XCreateGC(g_display, window, 0, nullptr);
+  g_window = window;
+  return true;
+}
+
+void Present(void* window_handle,
+             const void* pixels,
+             int32_t stride,
+             int32_t width,
+             int32_t height,
+             int32_t damage_x,
+             int32_t damage_y,
+             int32_t damage_width,
+             int32_t damage_height) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  Window window = static_cast<Window>(reinterpret_cast<uintptr_t>(window_handle));
+  if (!BindWindow(window)) {
+    return;
+  }
+  XImage* image = XCreateImage(g_display, g_visual, g_depth, ZPixmap, 0,
+                               static_cast<char*>(const_cast<void*>(pixels)),
+                               width, height, 32, stride);
+  if (!image) {
+    return;
+  }
+  XPutImage(g_display, window, g_gc, image, damage_x, damage_y, damage_x,
+            damage_y, damage_width, damage_height);
+  image->data = nullptr;  // Owned by the caller.
+  XDestroyImage(image);
+  // Write the request out now: |pixels| is only valid during this call.
+  XFlush(g_display);
+}
+
+const StarboardExtensionBitsosCanvasApi kBitsosCanvasApi = {
+    kStarboardExtensionBitsosCanvasName,
+    1,
+    &Present,
+};
+
+}  // namespace
+
+const void* GetBitsosCanvasApiX11() {
+  return &kBitsosCanvasApi;
+}
+
+}  // namespace starboard
