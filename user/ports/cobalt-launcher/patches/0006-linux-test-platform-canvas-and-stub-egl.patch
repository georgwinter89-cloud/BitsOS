diff --git a/starboard/shared/bitsos/egl_gles_stub.cc b/starboard/shared/bitsos/egl_gles_stub.cc
new file mode 100644
index 0000000000..acb3c94f14
--- /dev/null
+++ b/starboard/shared/bitsos/egl_gles_stub.cc
@@ -0,0 +1,125 @@
+// Copyright 2026 The Cobalt Authors. All Rights Reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "starboard/shared/bitsos/egl_gles_stub.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "starboard/common/log.h"
+
+namespace starboard {
+namespace bitsos {
+namespace {
+
+// Matches any interface entry: returns a zero value of its result type.
+template <typename F>
+struct Fail;
+template <typename R, typename... Args>
+struct Fail<R (*)(Args...)> {
+  static R Call(Args...) {
+    static bool logged = false;
+    if (!logged) {
+      logged = true;
+      SB_LOG(WARNING) << "BitsOS stub EGL called: " << __PRETTY_FUNCTION__;
+    }
+    return R();
+  }
+};
+
+SbEglInt32 GetErrorNotInitialized() {
+  SB_LOG(WARNING) << "BitsOS stub EGL called: eglGetError";
+  return SB_EGL_NOT_INITIALIZED;
+}
+
+const char* QueryStringEmpty(SbEglDisplay, SbEglInt32 name) {
+  SB_LOG(WARNING) << "BitsOS stub EGL called: eglQueryString " << name;
+  // EGL_EXTENSIONS: an empty client extension list instead of null.
+  return name == 0x3055 ? "" : nullptr;
+}
+
+SbEglInterface MakeFailingEgl() {
+  SbEglInterface i;
+  memset(&i, 0, sizeof(i));
+#define SB_FAIL(field) i.field = &Fail<decltype(i.field)>::Call
+  SB_FAIL(eglChooseConfig);
+  SB_FAIL(eglCopyBuffers);
+  SB_FAIL(eglCreateContext);
+  SB_FAIL(eglCreatePbufferSurface);
+  SB_FAIL(eglCreatePixmapSurface);
+  SB_FAIL(eglCreateWindowSurface);
+  SB_FAIL(eglDestroyContext);
+  SB_FAIL(eglDestroySurface);
+  SB_FAIL(eglGetConfigAttrib);
+  SB_FAIL(eglGetConfigs);
+  SB_FAIL(eglGetCurrentDisplay);
+  SB_FAIL(eglGetCurrentSurface);
+  SB_FAIL(eglGetDisplay);
+  SB_FAIL(eglGetProcAddress);
+  SB_FAIL(eglInitialize);
+  SB_FAIL(eglMakeCurrent);
+  SB_FAIL(eglQueryContext);
+  SB_FAIL(eglQuerySurface);
+  SB_FAIL(eglSwapBuffers);
+  SB_FAIL(eglTerminate);
+  SB_FAIL(eglWaitGL);
+  SB_FAIL(eglWaitNative);
+  SB_FAIL(eglBindTexImage);
+  SB_FAIL(eglReleaseTexImage);
+  SB_FAIL(eglSurfaceAttrib);
+  SB_FAIL(eglSwapInterval);
+  SB_FAIL(eglBindAPI);
+  SB_FAIL(eglQueryAPI);
+  SB_FAIL(eglCreatePbufferFromClientBuffer);
+  SB_FAIL(eglReleaseThread);
+  SB_FAIL(eglWaitClient);
+  SB_FAIL(eglGetCurrentContext);
+  SB_FAIL(eglCreateSync);
+  SB_FAIL(eglDestroySync);
+  SB_FAIL(eglClientWaitSync);
+  SB_FAIL(eglGetSyncAttrib);
+  SB_FAIL(eglCreateImage);
+  SB_FAIL(eglDestroyImage);
+  SB_FAIL(eglGetPlatformDisplay);
+  SB_FAIL(eglCreatePlatformWindowSurface);
+  SB_FAIL(eglCreatePlatformPixmapSurface);
+  SB_FAIL(eglWaitSync);
+#undef SB_FAIL
+  i.eglGetError = &GetErrorNotInitialized;
+  i.eglQueryString = &QueryStringEmpty;
+  return i;
+}
+
+}  // namespace
+
+const SbEglInterface* GetFailingEglInterface() {
+  static const SbEglInterface kInterface = MakeFailingEgl();
+  return &kInterface;
+}
+
+const SbGlesInterface* GetEmptyGlesInterface() {
+  static const SbGlesInterface kInterface = {};
+  return &kInterface;
+}
+
+bool IsStubEglRequested() {
+  static const bool requested = [] {
+    const char* v = getenv("BITSOS_STUB_EGL");
+    return v && *v && strcmp(v, "0") != 0;
+  }();
+  return requested;
+}
+
+}  // namespace bitsos
+}  // namespace starboard
diff --git a/starboard/shared/bitsos/egl_gles_stub.h b/starboard/shared/bitsos/egl_gles_stub.h
new file mode 100644
index 0000000000..a2fcf42c25
--- /dev/null
+++ b/starboard/shared/bitsos/egl_gles_stub.h
@@ -0,0 +1,42 @@
+// Copyright 2026 The Cobalt Authors. All Rights Reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// BitsOS port: an EGL that never initialises and an empty GLES table.
+// A platform without any GL hands these out, so Chromium's GL set-up fails
+// cleanly and it falls back to software compositing (dev.bitsos.Canvas).
+
+#ifndef STARBOARD_SHARED_BITSOS_EGL_GLES_STUB_H_
+#define STARBOARD_SHARED_BITSOS_EGL_GLES_STUB_H_
+
+#include "starboard/egl.h"
+#include "starboard/gles.h"
+
+namespace starboard {
+namespace bitsos {
+
+// Every call fails: displays and surfaces are null, booleans are false and
+// eglGetError() reports EGL_NOT_INITIALIZED.
+const SbEglInterface* GetFailingEglInterface();
+
+// All entries null.
+const SbGlesInterface* GetEmptyGlesInterface();
+
+// The Linux test platform keeps its real EGL unless the environment variable
+// BITSOS_STUB_EGL is set to something other than "0".
+bool IsStubEglRequested();
+
+}  // namespace bitsos
+}  // namespace starboard
+
+#endif  // STARBOARD_SHARED_BITSOS_EGL_GLES_STUB_H_
diff --git a/starboard/shared/egl/system_egl.cc b/starboard/shared/egl/system_egl.cc
index de928cc0d9..7100b9739e 100644
--- a/starboard/shared/egl/system_egl.cc
+++ b/starboard/shared/egl/system_egl.cc
@@ -17,6 +17,10 @@
 
 #include "starboard/egl.h"
 
+#if defined(STARBOARD_BITSOS_CANVAS)
+#include "starboard/shared/bitsos/egl_gles_stub.h"
+#endif
+
 #if !defined(EGL_VERSION_1_0) || !defined(EGL_VERSION_1_1) || \
     !defined(EGL_VERSION_1_2) || !defined(EGL_VERSION_1_3) || \
     !defined(EGL_VERSION_1_4)
@@ -123,5 +127,10 @@ const SbEglInterface g_sb_egl_interface = {
 }  // namespace
 
 const SbEglInterface* SbGetEglInterface() {
+#if defined(STARBOARD_BITSOS_CANVAS)
+  if (starboard::bitsos::IsStubEglRequested()) {
+    return starboard::bitsos::GetFailingEglInterface();
+  }
+#endif
   return &g_sb_egl_interface;
 }
