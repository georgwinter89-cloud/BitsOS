index 0000000..f50b319
--- /dev/null
+++ b/starboard/shared/bitsos/fb/application_bitsos_fb.h
@@ -0,0 +1,112 @@
+// BitsOS V2 Cobalt backend: the Starboard application for fbdev + evdev.
+//
+// Same job as ApplicationX11, without X: windows are rectangles on the
+// framebuffer (only the first is shown), input comes from evdev nodes, the
+// UI arrives through dev.bitsos.Canvas and video frames through punch-out
+// (AcceptFrame), and FbCompositor puts them together on the screen.
+
+#ifndef STARBOARD_SHARED_BITSOS_FB_APPLICATION_BITSOS_FB_H_
+#define STARBOARD_SHARED_BITSOS_FB_APPLICATION_BITSOS_FB_H_
+
+#include <stdint.h>
+
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include "starboard/common/rect.h"
+#include "starboard/player.h"
+#include "starboard/shared/bitsos/fb/evdev_decoder.h"
+#include "starboard/shared/bitsos/fb/evdev_devices.h"
+#include "starboard/shared/bitsos/fb/fb_compositor.h"
+#include "starboard/shared/bitsos/fb/fb_config.h"
+#include "starboard/shared/bitsos/fb/fb_device.h"
+#include "starboard/shared/internal_only.h"
+#include "starboard/shared/linux/time_zone_monitor.h"
+#include "starboard/shared/starboard/player/filter/video_frame_internal.h"
+#include "starboard/shared/starboard/queue_application.h"
+#include "starboard/window.h"
+
+namespace starboard {
+namespace bitsos {
+
+class ApplicationBitsosFb : public QueueApplication {
+ public:
+  explicit ApplicationBitsosFb(SbEventHandleCallback sb_event_handle_callback);
+  ~ApplicationBitsosFb() override;
+
+  static ApplicationBitsosFb* Get() {
+    return static_cast<ApplicationBitsosFb*>(Application::Get());
+  }
+
+  SbWindow CreateWindow(const SbWindowOptions* options);
+  bool DestroyWindow(SbWindow window);
+  bool GetWindowSize(SbWindow window, SbWindowSize* size);
+  void* GetPlatformHandle(SbWindow window);
+  void PlayerSetBounds(SbPlayer player, int z_index, const Rect& rect);
+
+  // dev.bitsos.Canvas Present (Chromium's compositor thread).
+  void Present(void* window_handle, const void* pixels, int32_t stride,
+               int32_t width, int32_t height, int32_t damage_x,
+               int32_t damage_y, int32_t damage_width, int32_t damage_height);
+
+ protected:
+  void AcceptFrame(SbPlayer player,
+                   const scoped_refptr<VideoFrame>& frame,
+                   int z_index,
+                   const Rect& rect) override;
+
+  bool IsStartImmediate() override { return !HasPreloadSwitch(); }
+  bool IsPreloadImmediate() override { return HasPreloadSwitch(); }
+
+  void Initialize() override;
+  void Teardown() override;
+
+  bool MayHaveSystemEvents() override;
+  Event* WaitForSystemEventWithTimeout(int64_t time) override;
+  void WakeSystemEventWait() override;
+
+ private:
+  struct Window;
+
+  std::shared_ptr<bitsos_fb::FbCompositor> Compositor();
+  Event* TakePending();
+  void SetGeometryLocked(int w, int h, const bitsos_fb::Placement& p);
+  void SetKdGraphics(bool on);
+
+  const bitsos_fb::Config config_;
+  bitsos_fb::FbDevice fb_;
+  bitsos_fb::EvdevDecoder decoder_;
+  std::unique_ptr<bitsos_fb::EvdevDevices> inputs_;
+  int wake_fd_ = -1;
+  int tty_fd_ = -1;
+  int64_t next_rescan_ = 0;
+  std::deque<bitsos_fb::InEvent> pending_;
+
+  // Windows and the compositor are reached from several threads.
+  std::mutex mutex_;
+  std::vector<Window*> windows_;
+  std::shared_ptr<bitsos_fb::FbCompositor> compositor_;
+  uint32_t next_handle_ = 1;
+  bool fb_failed_ = false;
+  // Set by CreateWindow/DestroyWindow (any thread), applied to the decoder
+  // by the event thread, which owns it.
+  bool geometry_changed_ = false;
+  int geometry_w_ = 0;
+  int geometry_h_ = 0;
+  bitsos_fb::Placement geometry_placement_;
+  int geometry_screen_w_ = 0;
+  int geometry_screen_h_ = 0;
+  // The frame last handed to the compositor, per player.
+  std::map<uintptr_t, scoped_refptr<VideoFrame>> last_frames_;
+
+  std::unique_ptr<::starboard::shared::linux::TimeZoneMonitor>
+      time_zone_monitor_;
+};
+
+}  // namespace bitsos
+}  // namespace starboard
+
+#endif  // STARBOARD_SHARED_BITSOS_FB_APPLICATION_BITSOS_FB_H_
diff --git a/starboard/shared/bitsos/fb/av_stats.cc b/starboard/shared/bitsos/fb/av_stats.cc
new file mode 100644
index 0000000..8c64754
--- /dev/null
+++ b/starboard/shared/bitsos/fb/av_stats.cc
@@ -0,0 +1,304 @@
+// BitsOS V2 Cobalt backend: A/V numbers (see av_stats.h).
+
+#include "starboard/shared/bitsos/fb/av_stats.h"
+
+#include <stdlib.h>
+#include <time.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cinttypes>
+
+namespace bitsos_fb {
+
+namespace {
+
+constexpr int64_t kFlushUs = 1'000'000;
+constexpr int64_t kLogUs = 10'000'000;
+constexpr int64_t kPlayerGoneUs = 10'000'000;
+
+int64_t MonotonicUs() {
+  timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<int64_t>(ts.tv_sec) * 1'000'000 + ts.tv_nsec / 1000;
+}
+
+void StderrLog(const std::string& line) {
+  fprintf(stderr, "bitsos-fb: %s\n", line.c_str());
+}
+
+std::string Ms(int64_t us) {
+  char b[32];
+  snprintf(b, sizeof(b), "%.1f", static_cast<double>(us) / 1000.0);
+  return b;
+}
+
+std::string WindowText(const char* name, const AvStats::Window& w) {
+  if (w.n == 0) {
+    return std::string(name) + " n=0\n";
+  }
+  char b[256];
+  snprintf(b, sizeof(b),
+           "%s n=%" PRIu64 " avg_ms=%s min_ms=%s max_ms=%s within_20ms=%" PRIu64
+           " within_40ms=%" PRIu64 " over_80ms=%" PRIu64 "\n",
+           name, w.n, Ms(w.sum_us / static_cast<int64_t>(w.n)).c_str(),
+           Ms(w.min_us).c_str(), Ms(w.max_us).c_str(), w.within_20ms,
+           w.within_40ms, w.over_80ms);
+  return b;
+}
+
+}  // namespace
+
+void AvStats::Window::Add(int64_t off_us) {
+  min_us = n == 0 ? off_us : std::min(min_us, off_us);
+  max_us = n == 0 ? off_us : std::max(max_us, off_us);
+  ++n;
+  sum_us += off_us;
+  const int64_t a = off_us < 0 ? -off_us : off_us;
+  within_20ms += a <= 20'000;
+  within_40ms += a <= 40'000;
+  over_80ms += a > 80'000;
+}
+
+AvStats* AvStats::Get() {
+  // Lives as long as the process: the player and compositor threads may
+  // still report while static destructors run.
+  static AvStats* stats =
+      new AvStats(getenv("BITSOS_AV_STATS"), getenv("BITSOS_AV_TRACE"),
+                  StderrLog, /*writer_thread=*/true);
+  return stats;
+}
+
+AvStats::AvStats(const char* stats_path, const char* trace_path, LogFn log,
+                 bool writer_thread)
+    : stats_path_(stats_path ? stats_path : ""), log_(log) {
+  if (trace_path && *trace_path) {
+    trace_ = fopen(trace_path, "ae");
+    if (!trace_ && log_) {
+      log_(std::string("av: cannot open the trace ") + trace_path);
+    }
+  }
+  if (writer_thread && (trace_ || !stats_path_.empty() || log_)) {
+    writer_ = std::thread([this] { WriterLoop(); });
+  }
+}
+
+AvStats::~AvStats() {
+  {
+    std::lock_guard<std::mutex> lock(out_mutex_);
+    stop_ = true;
+  }
+  wake_.notify_all();
+  if (writer_.joinable()) {
+    writer_.join();
+  }
+  std::lock_guard<std::mutex> io(io_mutex_);
+  FlushTrace();
+  if (trace_) {
+    fclose(trace_);
+  }
+}
+
+void AvStats::WriterLoop() {
+  std::unique_lock<std::mutex> lock(out_mutex_);
+  while (!stop_) {
+    wake_.wait_for(lock, std::chrono::microseconds(kWriterWakeUs));
+    if (stop_) {
+      break;
+    }
+    lock.unlock();
+    Flush(MonotonicUs());
+    lock.lock();
+  }
+}
+
+void AvStats::NoteRender(int64_t now_us, const void* who, int64_t media_us,
+                         bool playing, double rate, int64_t pts_us,
+                         int64_t dropped) {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++renders_;
+    auto it = players_.find(who);
+    if (it == players_.end()) {
+      it = players_.emplace(who, Player()).first;
+    }
+    // A count below the last one is a new player at the same address.
+    const int64_t base = dropped >= it->second.dropped ? it->second.dropped : 0;
+    dropped_ += static_cast<uint64_t>(dropped - base);
+    it->second.dropped = dropped;
+    it->second.seen_us = now_us;
+    for (auto p = players_.begin(); p != players_.end();) {
+      p = now_us - p->second.seen_us > kPlayerGoneUs ? players_.erase(p)
+                                                     : std::next(p);
+    }
+    media_us_ = media_us;
+    media_at_us_ = now_us;
+    playing_ = playing;
+    rate_ = rate;
+    (void)pts_us;
+    dirty_ = true;
+  }
+}
+
+void AvStats::NoteShown(int64_t now_us, int64_t pts_us, int w, int h) {
+  bool have = false;
+  int64_t off = 0;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++shown_;
+    last_pts_us_ = pts_us;
+    if (w > 0 && h > 0) {
+      last_w_ = w;
+      last_h_ = h;
+      if (static_cast<int64_t>(w) * h >
+          static_cast<int64_t>(max_w_) * max_h_) {
+        max_w_ = w;
+        max_h_ = h;
+      }
+    }
+    if (playing_ && media_us_ >= 0 && rate_ > 0) {
+      const int64_t clock =
+          media_us_ + static_cast<int64_t>(
+                          static_cast<double>(now_us - media_at_us_) * rate_);
+      off = pts_us - clock;
+      have = off <= kOffsetIgnoreUs && off >= -kOffsetIgnoreUs;
+    }
+    if (have) {
+      last_offset_us_ = off;
+      total_.Add(off);
+      recent_.Add(off);
+    } else {
+      ++skipped_;
+    }
+    dirty_ = true;
+  }
+  if (!trace_) {
+    return;
+  }
+  char b[96];
+  const int n =
+      have ? snprintf(b, sizeof(b), "shown %" PRId64 " %" PRId64 " %" PRId64
+                      "\n", now_us, pts_us, off)
+           : snprintf(b, sizeof(b), "shown %" PRId64 " %" PRId64 " -\n",
+                      now_us, pts_us);
+  if (n <= 0 || static_cast<size_t>(n) >= sizeof(b)) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(out_mutex_);
+  if (trace_pending_.size() + static_cast<size_t>(n) > kTracePendingMax) {
+    ++trace_lost_;
+  } else {
+    trace_pending_.append(b, static_cast<size_t>(n));
+  }
+}
+
+std::string AvStats::Text(int64_t now_us) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return TextLocked(now_us);
+}
+
+std::string AvStats::TextLocked(int64_t now_us) {
+  char b[512];
+  snprintf(b, sizeof(b),
+           "bitsos-av 1\n"
+           "time_us=%" PRId64 "\n"
+           "playing=%d rate=%.2f\n"
+           "media_time_us=%" PRId64 " read_us_ago=%" PRId64 "\n"
+           "last_pts_us=%" PRId64 " last_offset_ms=%s\n"
+           "frame_last=%dx%d frame_max=%dx%d\n"
+           "renders=%" PRIu64 " frames_shown=%" PRIu64
+           " frames_dropped=%" PRIu64 " offsets_skipped=%" PRIu64 "\n",
+           now_us, playing_ ? 1 : 0, rate_, media_us_, now_us - media_at_us_,
+           last_pts_us_, Ms(last_offset_us_).c_str(), last_w_, last_h_,
+           max_w_, max_h_, renders_, shown_,
+           dropped_, skipped_);
+  return std::string(b) + WindowText("offset_total", total_) +
+         WindowText("offset_recent", recent_);
+}
+
+void AvStats::FlushTrace() {
+  if (!trace_) {
+    return;
+  }
+  std::string text;
+  uint64_t lost = 0;
+  {
+    std::lock_guard<std::mutex> lock(out_mutex_);
+    text.swap(trace_pending_);
+    lost = trace_lost_;
+    trace_lost_ = 0;
+  }
+  if (lost) {
+    fprintf(trace_, "lost %" PRIu64 "\n", lost);
+    if (log_) {
+      log_("av: the trace writer fell behind, " + std::to_string(lost) +
+           " lines lost");
+    }
+  }
+  if (!text.empty()) {
+    fwrite(text.data(), 1, text.size(), trace_);
+  }
+  fflush(trace_);
+}
+
+void AvStats::Flush(int64_t now_us) {
+  std::lock_guard<std::mutex> io(io_mutex_);
+  FlushTrace();
+  std::string text;
+  std::string line;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (log_ && (logged_us_ == 0 || now_us - logged_us_ >= kLogUs)) {
+      // The first note only starts the first 10 s.
+      if (logged_us_ != 0 && shown_ != shown_at_log_) {
+        const double secs = static_cast<double>(now_us - logged_us_) / 1e6;
+        char b[160];
+        snprintf(b, sizeof(b),
+                 "av: %.1f frames/s shown, %" PRIu64 " dropped in %.0f s; ",
+                 static_cast<double>(shown_ - shown_at_log_) / secs,
+                 dropped_ - dropped_at_log_, secs);
+        line = b + WindowText("offset", recent_);
+        line.pop_back();
+      }
+      logged_us_ = now_us;
+      shown_at_log_ = shown_;
+      dropped_at_log_ = dropped_;
+      recent_ = Window();
+    }
+    if (!stats_path_.empty() && dirty_ &&
+        (flushed_us_ == 0 || now_us - flushed_us_ >= kFlushUs)) {
+      text = TextLocked(now_us);
+      flushed_us_ = now_us;
+      dirty_ = false;
+    }
+  }
+  if (!line.empty()) {
+    log_(line);
+  }
+  if (text.empty()) {
+    return;
+  }
+  // Readers see the old file or the new one, never half of one.
+  const std::string tmp = stats_path_ + ".new";
+  FILE* f = fopen(tmp.c_str(), "we");
+  if (!f) {
+    return;
+  }
+  const bool ok = fwrite(text.data(), 1, text.size(), f) == text.size();
+  if (fclose(f) == 0 && ok) {
+    rename(tmp.c_str(), stats_path_.c_str());
+  }
+}
+
+}  // namespace bitsos_fb
+
+// Weak in video_render_algorithm_impl.cc: called on every Render() that
+// draws a frame.
+extern "C" void BitsosAvNoteRender(const void* who, int64_t media_time_us,
+                                   bool audio_playing, double playback_rate,
+                                   int64_t frame_pts_us,
+                                   int64_t dropped_frames) {
+  bitsos_fb::AvStats::Get()->NoteRender(
+      bitsos_fb::MonotonicUs(), who, media_time_us, audio_playing,
+      playback_rate, frame_pts_us, dropped_frames);
+}
diff --git a/starboard/shared/bitsos/fb/av_stats.h b/starboard/shared/bitsos/fb/av_stats.h
new file mode 100644
index 0000000..4f39620
--- /dev/null
+++ b/starboard/shared/bitsos/fb/av_stats.h
@@ -0,0 +1,138 @@
+// BitsOS V2 Cobalt backend: picture against the audio clock, frame and drop
+// counts (YT-5).
+//
+// Starboard's render algorithm reports on every Render() that draws: the
+// audio clock (media time), the frame it chose and its drop counter
+// (BitsosAvNoteRender, a weak hook in video_render_algorithm_impl.cc). The
+// compositor reports when a frame reached the screen (NoteShown). The offset
+// of a shown frame = its timestamp minus the audio clock at that moment (the
+// last media time read, run on at the playback rate): > 0 the picture is
+// early, < 0 it is late. The audio clock is Cobalt's: frames written to ALSA
+// minus snd_pcm_delay, so this is the whole chain as far as the delay is
+// honest (SN-7).
+//
+// Out: a small key=value file (BITSOS_AV_STATS), replaced by rename at most
+// once a second while notes come in, so that MCP can read it at any time; a
+// log line every 10 s while frames are shown; with BITSOS_AV_TRACE one line
+// per shown frame ("shown <monotonic us> <pts us> <offset us|->", and
+// "lost <n>" if the writer fell more than kTracePendingMax behind).
+//
+// The notes only count under a lock; all file and log output is done by
+// Flush(), on a writer thread of its own (or by the caller in tests), so a
+// slow stick or profile file system cannot hold up frame choice or
+// presentation, which would show up as the very drops these numbers count.
+
+#ifndef STARBOARD_SHARED_BITSOS_FB_AV_STATS_H_
+#define STARBOARD_SHARED_BITSOS_FB_AV_STATS_H_
+
+#include <stdint.h>
+#include <stdio.h>
+
+#include <condition_variable>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace bitsos_fb {
+
+class AvStats {
+ public:
+  // Offsets over this are seeks or a second player, not sync.
+  static constexpr int64_t kOffsetIgnoreUs = 2'000'000;
+  // How often the writer thread flushes.
+  static constexpr int64_t kWriterWakeUs = 250'000;
+  // Trace text waiting for the writer; more is counted as lost, not kept, so
+  // a stalled file system cannot make Cobalt's memory grow.
+  static constexpr size_t kTracePendingMax = 1 << 20;
+
+  struct Window {
+    uint64_t n = 0;        // offsets counted
+    int64_t sum_us = 0;
+    int64_t min_us = 0;
+    int64_t max_us = 0;
+    uint64_t within_20ms = 0;
+    uint64_t within_40ms = 0;
+    uint64_t over_80ms = 0;
+    void Add(int64_t off_us);
+  };
+
+  typedef void (*LogFn)(const std::string& line);
+
+  // The process-wide instance, paths from the environment (may be unset).
+  static AvStats* Get();
+
+  // |writer_thread|: start the thread that calls Flush(); without it the
+  // caller does (tests, with their own clock).
+  AvStats(const char* stats_path, const char* trace_path, LogFn log,
+          bool writer_thread = false);
+  AvStats(const AvStats&) = delete;
+  AvStats& operator=(const AvStats&) = delete;
+  ~AvStats();
+
+  // From the render algorithm (player thread). |who| tells the players
+  // apart; |dropped| is that player's own running count.
+  void NoteRender(int64_t now_us, const void* who, int64_t media_us,
+                  bool playing, double rate, int64_t pts_us, int64_t dropped);
+  // From the compositor thread, after a new frame went to the screen;
+  // |w| x |h| is its decoded size (0 x 0 if unknown).
+  void NoteShown(int64_t now_us, int64_t pts_us, int w = 0, int h = 0);
+
+  // Writes what is due as of |now_us|: pending trace lines, the 10 s log
+  // line, the file (at most once a second, only if something changed).
+  void Flush(int64_t now_us);
+
+  // The file's text as of |now_us| (also for tests).
+  std::string Text(int64_t now_us);
+
+ private:
+  struct Player {
+    int64_t dropped = 0;
+    int64_t seen_us = 0;
+  };
+
+  void WriterLoop();
+  void FlushTrace();
+  std::string TextLocked(int64_t now_us);
+
+  const std::string stats_path_;
+  const LogFn log_;
+  FILE* trace_ = nullptr;
+
+  std::mutex io_mutex_;  // one Flush() at a time
+
+  std::mutex out_mutex_;  // the pending trace and the writer's stop flag
+  std::condition_variable wake_;
+  std::string trace_pending_;
+  uint64_t trace_lost_ = 0;
+  bool stop_ = false;
+  std::thread writer_;
+
+  std::mutex mutex_;  // the numbers
+  std::map<const void*, Player> players_;
+  uint64_t renders_ = 0;
+  uint64_t shown_ = 0;
+  uint64_t dropped_ = 0;
+  uint64_t skipped_ = 0;  // shown while paused, or offset ignored
+  int64_t media_us_ = -1;
+  int64_t media_at_us_ = 0;
+  bool playing_ = false;
+  double rate_ = 0;
+  int64_t last_pts_us_ = -1;
+  int64_t last_offset_us_ = 0;
+  int last_w_ = 0;
+  int last_h_ = 0;
+  int max_w_ = 0;  // the largest frame shown (by area)
+  int max_h_ = 0;
+  Window total_;
+  Window recent_;  // since the last log line
+  uint64_t shown_at_log_ = 0;
+  uint64_t dropped_at_log_ = 0;
+  int64_t logged_us_ = 0;
+  int64_t flushed_us_ = 0;
+  bool dirty_ = false;
+};
+
+}  // namespace bitsos_fb
+
+#endif  // STARBOARD_SHARED_BITSOS_FB_AV_STATS_H_
